DATABASE_URL="file:./dev.db"

# Required for customer/admin sessions. Generate at least 32 random bytes.
JWT_SECRET="replace-with-a-long-random-production-secret"

# Razorpay live credentials from Razorpay Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-live-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# Google Cloud OAuth 2.0 web client credentials.
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/auth/google/callback"
